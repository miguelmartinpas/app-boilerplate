# Theme activo de la app. Valores válidos: default | corporate | vibrant
# Si no se define, o el valor no coincide con ningún theme registrado, se usa "default".
EXPO_PUBLIC_THEME=default

# Credenciales del proyecto de Supabase (ver src/lib/supabase.ts).
# Usar la Project URL y la anon/publishable key del dashboard de Supabase
# (Project Settings > API). Nunca poner aquí la service_role key.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
